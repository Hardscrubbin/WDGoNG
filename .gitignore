# OS junk
.DS_Store
Thumbs.db

# --- Sensitive / personal data — must NEVER reach any remote (incl. private) ---
# GPS-tagged RF & wardriving logs, packet/handshake captures, per-user runtime
# logs. loot/ above already covers the session dirs; these add belt-and-braces
# for anything written elsewhere in the tree.
*.csv
*.pcap
*.pcapng
*.hccapx
*.22000
*.cap
.watchdogs/
evil_twin_capture.log
attack_events.log
# Local scratch / debug artefacts
scratch_*
scratchpad/

# Third-party firmware binaries (JanOS RF / projectZero flashes) — not ours to redistribute
assets/*.bin
whitelist.json

# Fleet keys / secrets — NEVER commit (bridge loads from ~/.wdgo/fleet.key, outside the repo)
*.key
fleet.key
.wdgo/
portal_sync.log
portal_sync.log.1
keyhunt_target.json
radio.json
graphify-out/

# secret-guard local patterns (device-specific, never public)
*.secret-patterns.local

