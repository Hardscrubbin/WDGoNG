scratch_*
scratchpad/

# Third-party firmware binaries (JanOS RF / projectZero flashes) — not ours to redistribute
assets/*.bin
whitelist.json

# Fleet keys / secrets — NEVER commit (bridge loads from ~/.wdgo/fleet.key, outside the repo)
*.key
fleet.key
